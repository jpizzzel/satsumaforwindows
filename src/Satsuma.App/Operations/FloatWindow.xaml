<Window x:Class="Satsuma.App.Operations.FloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Satsuma float"
        Width="220"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowDrop="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border Background="#F2242221" CornerRadius="12" Margin="10" Padding="0,0,0,8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" />
        </Border.Effect>
        <StackPanel>
            <Grid x:Name="Header" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Header_MouseDown">
                <TextBlock x:Name="Caption" Foreground="#B8FFFFFF" FontSize="11" Margin="12,8,0,6" VerticalAlignment="Center" />
                <Button Content="&#xE711;" HorizontalAlignment="Right" Click="Close_Click" ToolTip="Close"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Padding="8"
                        Background="Transparent" BorderThickness="0" Foreground="#B8FFFFFF" Cursor="Arrow" />
            </Grid>
            <ItemsControl x:Name="Items" Cursor="Hand" Background="Transparent"
                          PreviewMouseLeftButtonDown="Items_MouseDown" PreviewMouseMove="Items_MouseMove"
                          ToolTip="Drag to drop these files anywhere">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="12,3,12,3">
                            <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" MaxWidth="150"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
