<Window x:Class="Satsuma.App.Jobs.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Satsuma"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>
    <ItemsControl x:Name="Cards" Margin="12,0,12,12">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Background="#F2242221" CornerRadius="10" Padding="14,10,8,12" Margin="0,8,0,0"
                        Cursor="Hand" MouseLeftButtonUp="Card_Click" ToolTip="{Binding Hint}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Glyph}" Foreground="{Binding Accent}" FontSize="18" Margin="0,2,12,0"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Foreground="#B8FFFFFF" FontSize="12" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="48" />
                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}"
                                         Visibility="{Binding IsRunning, Converter={StaticResource Visible}}"
                                         Height="4" Margin="0,8,6,0" BorderThickness="0"
                                         Foreground="#F5841F" Background="#30FFFFFF" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="&#xE711;" Click="Close_Click" ToolTip="{Binding CloseHint}"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Padding="6"
                                Background="Transparent" BorderThickness="0" Foreground="#B8FFFFFF"
                                VerticalAlignment="Top" Cursor="Arrow" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>
