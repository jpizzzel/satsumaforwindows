<Window x:Class="Satsuma.App.Wheel.WheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Satsuma wheel"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowDrop="True"
        Focusable="False"
        UseLayoutRounding="True">
    <!-- Only the painted wheel is hit-testable; the transparent corners let drags pass to the window below. -->
    <Canvas x:Name="Surface" AllowDrop="True">
        <Canvas.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" />
        </Canvas.Effect>
    </Canvas>
</Window>
